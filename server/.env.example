# =============================================
# StyleSynk Server — Environment Variables
# =============================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stylesynk
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# JWT Auth
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Groq AI
GROQ_API_KEY=your_groq_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# MongoDB (Optional - for hybrid database support)
USE_MONGODB=false
MONGODB_URI=mongodb://localhost:27017/stylesynk
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stylesynk?retryWrites=true&w=majority
